{
  "schemaVersion": 1,
  "id": "bwind.ad-block",
  "name": "Bloqueador de Anúncios",
  "version": "1.0.0",
  "description": "Bloqueia domínios comuns de publicidade e oculta espaços de anúncio na página.",
  "type": "content-and-network-filter",
  "matches": ["*"],
  "permissions": ["content_script", "network_filter"],
  "entry": {
    "script": "script.js",
    "style": "styles.css",
    "rules": "rules.json"
  },
  "minBrowserVersion": "1.1.0",
  "updateChannel": "stable"
}
