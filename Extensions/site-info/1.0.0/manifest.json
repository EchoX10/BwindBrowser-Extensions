{
  "schemaVersion": 1,
  "id": "bwind.site-info",
  "name": "Informações do Site",
  "version": "1.0.0",
  "description": "Adiciona um botão para mostrar título, domínio e endereço da página.",
  "type": "browser-command",
  "matches": [
    "*"
  ],
  "permissions": [
    "browser_command"
  ],
  "entry": {
    "script": "script.js"
  },
  "browserAction": {
    "id": "site-info",
    "label": "Site",
    "placement": "main_browser_bar"
  },
  "minBrowserVersion": "1.1.0",
  "updateChannel": "stable"
}
