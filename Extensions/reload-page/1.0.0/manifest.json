{
  "schemaVersion": 1,
  "id": "bwind.reload-page",
  "name": "Recarregar Página",
  "version": "1.0.0",
  "description": "Adiciona um botão para recarregar imediatamente a página aberta.",
  "type": "browser-command",
  "matches": [
    "*"
  ],
  "permissions": [
    "browser_command"
  ],
  "entry": {
    "script": "script.js"
  },
  "browserAction": {
    "id": "reload",
    "label": "Recarregar",
    "placement": "main_browser_bar"
  },
  "minBrowserVersion": "1.1.0",
  "updateChannel": "stable"
}
