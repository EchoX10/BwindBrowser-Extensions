{
  "schemaVersion": 1,
  "id": "bwind.translate-english",
  "name": "Traduzir para Inglês",
  "version": "1.0.0",
  "description": "Adiciona um botão para abrir a tradução da página para inglês.",
  "type": "browser-command",
  "matches": [
    "*"
  ],
  "permissions": [
    "browser_command"
  ],
  "entry": {
    "script": "script.js"
  },
  "browserAction": {
    "id": "translate-en",
    "label": "Inglês",
    "placement": "main_browser_bar"
  },
  "minBrowserVersion": "1.1.0",
  "updateChannel": "stable"
}
